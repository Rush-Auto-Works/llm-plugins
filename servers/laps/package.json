{
  "name": "rush-lap-analyzer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "build:skill": "esbuild src/cli.ts --bundle --format=esm --platform=node --target=node22 --banner:js='// Generated by npm run build:skill in servers/laps. Do not edit.' --outfile=../../plugin/skills/rush-sr-laps/scripts/engine.mjs",
    "deploy:preview": "wrangler versions upload --preview-alias preview"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.137.0"
  }
}
